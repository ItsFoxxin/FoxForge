include AGENTS.md
recursive-include .github *.yml
recursive-include docs *.md
recursive-include scripts *.ps1
recursive-include templates *.md *.json
recursive-include examples *.py *.md *.json
recursive-include ci *.py
recursive-include tests *.py
recursive-include tests/fixtures *.json
include Dockerfile .dockerignore compose.yaml CHANGELOG.md
recursive-include deployment *.txt *.example *.json *.service *.timer
global-exclude *.py[cod]
global-exclude VALIDATION.txt
prune .pytest_cache

include Dockerfile.worker
