# Nonsecret values only. Host: /etc/foxforge-container/container.env.
# The protected host config directory is mounted at /etc/foxforge in the image.
FOXFORGE_DATA_DIR=/var/lib/foxforge/control-plane
FOXFORGE_REPOS_DIR=/var/lib/foxforge/repos
FOXFORGE_CONFIG_DIR=/etc/foxforge
FOXFORGE_GITHUB_APP_ID=REPLACE_WITH_NUMERIC_APP_ID
FOXFORGE_GITHUB_INSTALLATION_ID=REPLACE_WITH_NUMERIC_INSTALLATION_ID
FOXFORGE_GITHUB_PRIVATE_KEY=/etc/foxforge/github-app.pem
FOXFORGE_ALLOWED_GITHUB_USER_IDS=REPLACE_WITH_NUMERIC_USER_IDS
FOXFORGE_MODEL_POLICY_FILE=/etc/foxforge/model-policy.json
FOXFORGE_PLANNER_BASE_URL=http://freellmapi:3001/v1
FOXFORGE_PLANNER_HTTP_HOSTS=freellmapi
FOXFORGE_PLANNER_API_KEY_FILE=/etc/foxforge/gateway-api-key
FOXFORGE_PLANNER_MODEL=REPLACE_WITH_APPROVED_MODEL_ID
